<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app preferences and databases in cloud backup. -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <!-- Exclude device-only preferences that should not roam across installs. -->
        <exclude domain="sharedpref" path="device.xml"/>
    </cloud-backup>

    <!-- Mirror backup coverage for direct device-to-device transfer. -->
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
    </device-transfer>
</data-extraction-rules>